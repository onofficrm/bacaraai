<?php
/**
 * 테이블별 라이브 스트림 URL 설정
 * 복사: data/bacaraai-streams.config.php
 *
 * STREAM_KEY = 테이블 코드(gameCode) = OBS RTMP 경로
 * 예: MD2729 → https://media.aitablelive.com/MD2729/index.m3u8
 */
if (!defined('_GNUBOARD_')) {
    exit;
}

return array(
    'enabled' => true,
    /**
     * 개별 tables 항목이 없을 때 사용.
     * 플레이스홀더: {STREAM_KEY} {stream_key} {table} {TABLE} {code} {CODE}
     */
    'url_template' => 'https://media.aitablelive.com/{STREAM_KEY}/index.m3u8',
    /** 예외 테이블만 개별 URL (비우면 템플릿 사용) */
    'tables' => array(
        // 'MD2729' => 'https://media.aitablelive.com/MD2729/index.m3u8',
    ),
);
